{
  "machine": "coding_harness",
  "views": {
    "gather_input": {
      "root": "root",
      "elements": {
        "root": {
          "type": "Stack",
          "props": { "direction": "vertical", "gap": "md" },
          "children": ["header_card", "transcript", "prompt_bar", "actions"]
        },
        "header_card": {
          "type": "Card",
          "props": { "title": "02 — Coding Harness (@starness/llm + @starness/decide + @starness/exec)" },
          "children": ["meta_kv"]
        },
        "meta_kv": {
          "type": "KeyValue",
          "props": {
            "items": {
              "model": { "$state": "/model" },
              "tool_runs": { "$state": "/tool_runs" },
              "last_decision": { "$state": "/last_decision" }
            }
          }
        },
        "transcript": {
          "type": "Conversation",
          "props": {
            "title": "Conversation",
            "messages": { "$state": "/messages" },
            "empty_text": "Ask the coding harness to inspect files or run commands."
          }
        },
        "prompt_bar": {
          "type": "PromptInput",
          "props": {
            "label": "Message",
            "placeholder": "Ask the coding harness or drag a file… (/exit to quit)",
            "submit_event": "PROMPT",
            "submit_label": "Send",
            "field_name": "text",
            "allow_attachments": true
          }
        },
        "actions": {
          "type": "Stack",
          "props": { "direction": "horizontal", "gap": "sm" },
          "children": ["btn_exit"]
        },
        "btn_exit": {
          "type": "Button",
          "props": { "label": "Exit Session", "event": "EXIT", "variant": "secondary" }
        }
      }
    },
    "awaiting_approval": {
      "root": "root",
      "elements": {
        "root": {
          "type": "Stack",
          "props": { "direction": "vertical", "gap": "md" },
          "children": ["warn_alert", "transcript", "pending_table", "actions"]
        },
        "warn_alert": {
          "type": "Alert",
          "props": {
            "title": "Permission Gate — Human Approval Required",
            "message": "@starness/decide routed this command batch for human confirmation. Review below before approving.",
            "variant": "warning"
          }
        },
        "transcript": {
          "type": "Conversation",
          "props": {
            "title": "Conversation",
            "messages": { "$state": "/messages" }
          }
        },
        "pending_table": {
          "type": "Table",
          "props": {
            "title": "Commands Awaiting Approval",
            "columns": ["Tool", "Command", "Decision"],
            "rows": { "$state": "/approval_rows" }
          }
        },
        "actions": {
          "type": "Stack",
          "props": { "direction": "horizontal", "gap": "sm" },
          "children": ["btn_approve", "btn_deny", "btn_interrupt"]
        },
        "btn_approve": {
          "type": "Button",
          "props": { "label": "Approve & Run", "event": "APPROVE", "variant": "primary" }
        },
        "btn_deny": {
          "type": "Button",
          "props": { "label": "Deny", "event": "DENY", "variant": "danger" }
        },
        "btn_interrupt": {
          "type": "Button",
          "props": { "label": "Interrupt", "event": "INTERRUPT", "variant": "secondary", "shortcut": "Esc" }
        }
      }
    },
    "working": {
      "root": "root",
      "elements": {
        "root": {
          "type": "Stack",
          "props": { "direction": "vertical", "gap": "md" },
          "children": ["status_card", "transcript", "actions"]
        },
        "status_card": {
          "type": "Card",
          "props": { "title": "Coding Harness Working…" },
          "children": ["status_badge"]
        },
        "status_badge": {
          "type": "Badge",
          "props": { "label": "Thinking / classifying permissions / executing tools", "variant": "info" }
        },
        "transcript": {
          "type": "Conversation",
          "props": {
            "title": "Conversation",
            "messages": { "$state": "/messages" }
          }
        },
        "actions": {
          "type": "Stack",
          "props": { "direction": "horizontal", "gap": "sm" },
          "children": ["btn_interrupt"]
        },
        "btn_interrupt": {
          "type": "Button",
          "props": { "label": "Interrupt", "event": "INTERRUPT", "variant": "danger", "shortcut": "Esc" }
        }
      }
    },
    "failed": {
      "root": "root",
      "elements": {
        "root": {
          "type": "Stack",
          "props": { "direction": "vertical", "gap": "md" },
          "children": ["error_alert", "transcript"]
        },
        "error_alert": {
          "type": "Alert",
          "props": {
            "variant": "danger",
            "title": "Coding Harness Failed",
            "message": { "$state": "/error" }
          }
        },
        "transcript": {
          "type": "Conversation",
          "props": {
            "title": "Conversation",
            "messages": { "$state": "/messages" }
          }
        }
      }
    }
  }
}
