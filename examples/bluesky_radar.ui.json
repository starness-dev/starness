{
  "machine": "bluesky_radar",
  "views": {
    "waiting": {
      "root": "root",
      "elements": {
        "root": {
          "type": "Stack",
          "props": { "direction": "vertical", "gap": "md" },
          "children": ["status_card", "controls_card", "posts_table"]
        },
        "status_card": {
          "type": "Card",
          "props": { "title": "Bluesky Live Feed" },
          "children": ["status_badge", "summary_kv"]
        },
        "status_badge": {
          "type": "Badge",
          "props": { "label": { "$state": "/status_label" }, "variant": "success" }
        },
        "summary_kv": {
          "type": "KeyValue",
          "props": { "items": { "$state": "/summary_kv" } }
        },
        "controls_card": {
          "type": "Card",
          "props": { "title": "Controls" },
          "children": ["query_input", "btn_row"]
        },
        "query_input": {
          "type": "TextInput",
          "props": { "label": "Search Query", "bind": "/query", "placeholder": "ai harness" }
        },
        "btn_row": {
          "type": "Stack",
          "props": { "direction": "horizontal", "gap": "sm" },
          "children": ["btn_update", "btn_refresh", "btn_pause", "btn_stop"]
        },
        "btn_update": {
          "type": "Button",
          "props": { "label": "Update Query", "event": "UPDATE_QUERY", "variant": "primary" }
        },
        "btn_refresh": {
          "type": "Button",
          "props": { "label": "Refresh Now", "event": "REFRESH", "variant": "secondary" }
        },
        "btn_pause": {
          "type": "Button",
          "props": { "label": "Pause", "event": "PAUSE", "variant": "secondary" }
        },
        "btn_stop": {
          "type": "Button",
          "props": { "label": "Stop", "event": "STOP", "variant": "danger" }
        },
        "posts_table": {
          "type": "Table",
          "props": {
            "title": "Latest Posts (max 10)",
            "columns": ["Author", "Likes", "Post"],
            "rows": { "$state": "/posts_rows" }
          }
        }
      }
    },
    "paused": {
      "root": "root",
      "elements": {
        "root": {
          "type": "Stack",
          "props": { "direction": "vertical", "gap": "md" },
          "children": ["status_card", "controls_card", "posts_table"]
        },
        "status_card": {
          "type": "Card",
          "props": { "title": "Bluesky Live Feed (Paused)" },
          "children": ["status_badge", "summary_kv"]
        },
        "status_badge": {
          "type": "Badge",
          "props": { "label": { "$state": "/status_label" }, "variant": "warning" }
        },
        "summary_kv": {
          "type": "KeyValue",
          "props": { "items": { "$state": "/summary_kv" } }
        },
        "controls_card": {
          "type": "Card",
          "props": { "title": "Controls" },
          "children": ["query_input", "btn_row"]
        },
        "query_input": {
          "type": "TextInput",
          "props": { "label": "Search Query", "bind": "/query", "placeholder": "ai harness" }
        },
        "btn_row": {
          "type": "Stack",
          "props": { "direction": "horizontal", "gap": "sm" },
          "children": ["btn_update", "btn_resume", "btn_stop"]
        },
        "btn_update": {
          "type": "Button",
          "props": { "label": "Update Query", "event": "UPDATE_QUERY", "variant": "primary" }
        },
        "btn_resume": {
          "type": "Button",
          "props": { "label": "Resume (10s)", "event": "RESUME", "variant": "primary" }
        },
        "btn_stop": {
          "type": "Button",
          "props": { "label": "Stop", "event": "STOP", "variant": "danger" }
        },
        "posts_table": {
          "type": "Table",
          "props": {
            "title": "Latest Posts (max 10)",
            "columns": ["Author", "Likes", "Post"],
            "rows": { "$state": "/posts_rows" }
          }
        }
      }
    }
  }
}
