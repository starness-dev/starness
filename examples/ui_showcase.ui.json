{
  "machine": "ui_showcase",
  "views": {
    "display": {
      "root": "root",
      "elements": {
        "root": {
          "type": "Stack",
          "props": { "direction": "vertical", "gap": "md" },
          "children": ["header_card", "crates_table", "intro_md", "nav_row"]
        },
        "header_card": {
          "type": "Card",
          "props": { "title": "1 / 5 · Display Widgets" },
          "children": ["badge", "kv", "alert_info"]
        },
        "badge": {
          "type": "Badge",
          "props": { "label": { "$state": "/step_badge" }, "variant": "info" }
        },
        "kv": {
          "type": "KeyValue",
          "props": { "items": { "$state": "/metrics" } }
        },
        "alert_info": {
          "type": "Alert",
          "props": {
            "title": "Dual-Target Catalog",
            "message": "Same *.ui.json renders in both Ratatui TUI and embedded Web Studio.",
            "variant": "success"
          }
        },
        "crates_table": {
          "type": "Table",
          "props": {
            "title": "Workspace Crates",
            "columns": ["Crate", "Status", "Purpose"],
            "rows": { "$state": "/services_rows" }
          }
        },
        "intro_md": {
          "type": "Markdown",
          "props": {
            "title": "Tip",
            "content": { "$state": "/overview_md" }
          }
        },
        "nav_row": {
          "type": "Stack",
          "props": { "direction": "horizontal", "gap": "sm" },
          "children": ["btn_next", "btn_finish"]
        },
        "btn_next": {
          "type": "Button",
          "props": { "label": "Next: Inputs →", "event": "NEXT", "variant": "primary" }
        },
        "btn_finish": {
          "type": "Button",
          "props": { "label": "Finish", "event": "FINISH", "variant": "secondary" }
        }
      }
    },
    "inputs": {
      "root": "root",
      "elements": {
        "root": {
          "type": "Stack",
          "props": { "direction": "vertical", "gap": "md" },
          "children": ["title_card", "reviewer_in", "notes_area", "env_select", "checks_multi", "nav_row"]
        },
        "title_card": {
          "type": "Card",
          "props": { "title": "2 / 5 · Input & Action Widgets" },
          "children": ["badge"]
        },
        "badge": {
          "type": "Badge",
          "props": { "label": "Tab between inputs & Actions", "variant": "warning" }
        },
        "reviewer_in": {
          "type": "TextInput",
          "props": { "label": "Reviewer Handle", "bind": "/reviewer", "placeholder": "name" }
        },
        "notes_area": {
          "type": "Textarea",
          "props": { "label": "Release Notes", "bind": "/notes_text", "rows": 3 }
        },
        "env_select": {
          "type": "Select",
          "props": { "label": "Target Environment", "bind": "/environment", "options": ["dev", "staging", "production"] }
        },
        "checks_multi": {
          "type": "MultiSelect",
          "props": {
            "label": "Pre-flight Checks",
            "bind": "/checklist",
            "options": [
              { "id": "clippy", "label": "Clippy clean", "description": "Zero warnings across workspace" },
              { "id": "tests", "label": "Tests passing", "description": "Unit + E2E test suite" },
              { "id": "docs", "label": "Docs updated", "description": "README and skill references" }
            ]
          }
        },
        "nav_row": {
          "type": "Stack",
          "props": { "direction": "horizontal", "gap": "sm" },
          "children": ["btn_back", "btn_next", "btn_finish"]
        },
        "btn_back": {
          "type": "Button",
          "props": { "label": "← Back", "event": "BACK", "variant": "secondary" }
        },
        "btn_next": {
          "type": "Button",
          "props": { "label": "Next: Markdown Review →", "event": "NEXT", "variant": "primary" }
        },
        "btn_finish": {
          "type": "Button",
          "props": { "label": "Finish", "event": "FINISH", "variant": "danger" }
        }
      }
    },
    "markdown_review": {
      "root": "root",
      "elements": {
        "root": {
          "type": "Stack",
          "props": { "direction": "vertical", "gap": "md" },
          "children": ["md_rev", "btn_back"]
        },
        "md_rev": {
          "type": "MarkdownReview",
          "props": {
            "title": "3 / 5 · MarkdownReview",
            "markdown": { "$state": "/review_md" },
            "agent_notes": { "$state": "/review_notes" },
            "comments_path": "/review_comments",
            "approve_event": "APPROVE",
            "revise_event": "REVISE",
            "approve_label": "Next: Diff Review →",
            "revise_label": "Request Changes"
          }
        },
        "btn_back": {
          "type": "Button",
          "props": { "label": "← Back", "event": "BACK", "variant": "secondary" }
        }
      }
    },
    "diff_review": {
      "root": "root",
      "elements": {
        "root": {
          "type": "Stack",
          "props": { "direction": "vertical", "gap": "md" },
          "children": ["diff_rev", "btn_back"]
        },
        "diff_rev": {
          "type": "DiffReview",
          "props": {
            "title": "4 / 5 · DiffReview",
            "diff": { "$state": "/patch_diff" },
            "comments_path": "/diff_comments",
            "approve_event": "APPROVE",
            "revise_event": "REVISE",
            "approve_label": "Next: AI Elements →",
            "revise_label": "Request Changes"
          }
        },
        "btn_back": {
          "type": "Button",
          "props": { "label": "← Back", "event": "BACK", "variant": "secondary" }
        }
      }
    },
    "ai_elements": {
      "root": "root",
      "elements": {
        "root": {
          "type": "Stack",
          "props": { "direction": "vertical", "gap": "md" },
          "children": ["header_card", "convo", "reasoning_card", "tool_card", "term_card", "prompt_bar", "nav_row"]
        },
        "header_card": {
          "type": "Card",
          "props": { "title": "5 / 5 · AI Workflow Elements" },
          "children": ["plan_tasks"]
        },
        "plan_tasks": {
          "type": "TaskList",
          "props": {
            "title": "Agent Plan",
            "tasks": { "$state": "/ai_tasks" }
          }
        },
        "convo": {
          "type": "Conversation",
          "props": {
            "title": "Agent Conversation",
            "messages": { "$state": "/ai_messages" }
          }
        },
        "reasoning_card": {
          "type": "Reasoning",
          "props": {
            "title": "Model Reasoning",
            "content": { "$state": "/ai_reasoning" },
            "duration_ms": 1240,
            "expanded": true
          }
        },
        "tool_card": {
          "type": "ToolCall",
          "props": {
            "name": "bash",
            "status": "ok",
            "arguments": { "$state": "/ai_tool_args" },
            "output": { "$state": "/ai_tool_out" }
          }
        },
        "term_card": {
          "type": "Terminal",
          "props": {
            "command": "cargo test --workspace",
            "stdout": { "$state": "/ai_cmd_stdout" },
            "exit_code": 0
          }
        },
        "prompt_bar": {
          "type": "PromptInput",
          "props": {
            "label": "Send Follow-Up Prompt",
            "placeholder": "Type a message and press Enter…",
            "submit_event": "PROMPT",
            "submit_label": "Send",
            "field_name": "text"
          }
        },
        "nav_row": {
          "type": "Stack",
          "props": { "direction": "horizontal", "gap": "sm" },
          "children": ["btn_back", "btn_finish"]
        },
        "btn_back": {
          "type": "Button",
          "props": { "label": "← Back", "event": "BACK", "variant": "secondary" }
        },
        "btn_finish": {
          "type": "Button",
          "props": { "label": "Finish Showcase", "event": "FINISH", "variant": "primary" }
        }
      }
    }
  }
}
